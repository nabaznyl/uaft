#!/bin/bash
# Pre-push hook: Validate code before pushing
# Installed by UAFT

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

PUSH_BLOCKED=0

echo -e "${YELLOW}[pre-push] Running validation checks...${NC}"

# Check 1: No debug code in staged changes
echo -ne "${YELLOW}  → Checking for debug code...${NC} "
if git diff --cached | grep -E "(console\.log|debugger|pdb\.set_trace|print\(|TODO REMOVE)" > /dev/null; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}    Debug code detected! Remove before pushing.${NC}"
    PUSH_BLOCKED=1
else
    echo -e "${GREEN}OK${NC}"
fi

# Check 2: File size validation
echo -ne "${YELLOW}  → Checking file sizes...${NC} "
MAX_SIZE=$((10 * 1024 * 1024))  # 10MB
LARGE_FILES=0
while IFS= read -r file; do
    if [[ -f "$file" ]]; then
        SIZE=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
        if [ "$SIZE" -gt "$MAX_SIZE" ]; then
            echo -e "${RED}FAILED${NC}"
            echo -e "${RED}    File too large: $file ($(numfmt --to=iec-i --suffix=B $SIZE 2>/dev/null || echo "$SIZE bytes"))${NC}"
            ((LARGE_FILES++))
            PUSH_BLOCKED=1
        fi
    fi
done < <(git diff --cached --name-only)

if [ "$LARGE_FILES" -eq 0 ]; then
    echo -e "${GREEN}OK${NC}"
fi

# Check 3: Lint validation (project-specific)
PROJECT_DIR="$(git rev-parse --show-toplevel)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"

if [[ -f "Makefile" ]]; then
    echo -ne "${YELLOW}  → Running linting (via Makefile)...${NC} "
    if make lint > /dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC}"
        echo -e "${RED}    Lint errors found. Fix with: make format${NC}"
        PUSH_BLOCKED=1
    fi
elif [[ -f "uaft.yaml" ]]; then
     echo -ne "${YELLOW}  → Running linting (via uaft)...${NC} "
     if uaft check > /dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
     else
        echo -e "${RED}FAILED${NC}"
        echo -e "${RED}    Lint errors found.${NC}"
        PUSH_BLOCKED=1
     fi
fi

# Final result
echo ""
if [ "$PUSH_BLOCKED" -eq 0 ]; then
    echo -e "${GREEN}[pre-push] All checks passed! ✅ Ready to push.${NC}"
    exit 0
else
    echo -e "${RED}[pre-push] Push blocked due to validation errors ❌${NC}"
    exit 1
fi
