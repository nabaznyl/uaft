#!/bin/bash
# ============================================================================
# UAFT - Universal Automation Framework Tool
# ============================================================================
# Main entry point / Bootstrap script for UAFT CLI
#
# This script serves as the primary interface for all UAFT operations.
# It handles command routing, module loading, and provides a unified
# interface for cleanup, testing, plugin management, and more.
#
# Usage: uaft [command] [options]
#
# Environment Variables:
#   UAFT_DEBUG=1     Enable debug logging
#   UAFT_HOME        Override config directory (default: ~/.uaft)
#   NO_COLOR=1       Disable colored output
#
# Exit Codes:
#   0 - Success
#   1 - General error
#   2 - Invalid command/usage
#   127 - Command not found
#
# Version: See VERSION file
# License: MIT
# ============================================================================

set -euo pipefail

# ============================================================================
# Bootstrap Configuration
# ============================================================================
# Determine script location and set up environment variables.
# These are exported for use by all submodules.

# Get script directory (resolves symlinks)
UAFT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Read version from VERSION file, fallback to default
UAFT_VERSION=$(cat "${UAFT_ROOT}/VERSION" 2>/dev/null || echo "0.0.1-alpha")

# Export for subshells
export UAFT_ROOT
export UAFT_VERSION
export PATH="${UAFT_ROOT}/src:${PATH}"

# Enable Error DB Trap if module loaded
if type -t handle_error_trap >/dev/null; then
    trap 'handle_error_trap' ERR
fi

# ============================================================================
# Module Loading
# ============================================================================
# Load modules in dependency order. Core utils must load first.
# Optional modules use `|| true` to allow graceful degradation.

# Load utils module (foundation for everything - REQUIRED)
source "${UAFT_ROOT}/src/utils.sh"

# Load support modules for improved UX and robustness (optional)
source "${UAFT_ROOT}/src/interactive.sh" 2>/dev/null || true
source "${UAFT_ROOT}/src/validation.sh" 2>/dev/null || true
source "${UAFT_ROOT}/src/audit.sh" 2>/dev/null || true
source "${UAFT_ROOT}/src/error_db.sh" 2>/dev/null || true

# Load plugin system modules (optional)
source "${UAFT_ROOT}/src/plugin_manager.sh" 2>/dev/null || true

source "${UAFT_ROOT}/src/plugin_registry.sh" 2>/dev/null || true

# Load new robustness and testing systems (optional)
source "${UAFT_ROOT}/src/plugin_cleanup_system.sh" 2>/dev/null || true
source "${UAFT_ROOT}/src/test_runner.sh" 2>/dev/null || true
source "${UAFT_ROOT}/src/cleanup_all_system.sh" 2>/dev/null || true
source "${UAFT_ROOT}/src/watch.sh" 2>/dev/null || true
source "${UAFT_ROOT}/src/task_runner.sh" 2>/dev/null || true
source "${UAFT_ROOT}/src/security.sh" 2>/dev/null || true

# ============================================================================
# Main Entry Point
# ============================================================================
# Routes commands to appropriate handlers. Handles global flags first,
# then dispatches to command-specific functions.
#
# Arguments:
#   $1 - Command name (e.g., cleanup, test, plugin)
#   $@ - Additional arguments passed to command handler
#
# Returns:
#   Exit code from command handler, or 2 for unknown commands

main() {
    local command="${1:-}"
    
    # Handle global flags (--version, --features, --interactive, --help)
    # These take precedence over commands
    
    # Show version and exit
    if [[ "$command" == "--version" ]] || [[ "$command" == "-v" ]]; then
        cmd_version
        exit 0
    fi
    
    # Show features list
    if [[ "$command" == "--features" ]] || [[ "$command" == "-F" ]]; then
        show_features_list
        exit 0
    fi
    
    # Interactive mode
    if [[ "$command" == "--interactive" ]] || [[ "$command" == "-i" ]]; then
        interactive_mode
        exit $?
    fi
    
    # Show help
    if [[ "$command" == "--help" ]] || [[ "$command" == "-h" ]] || [[ -z "$command" ]]; then
        show_help
        exit 0
    fi
    
    # Command dispatch - route to appropriate handler
    case "$command" in
        init)
            cmd_init "${@:2}"
            ;;
        detect)
            cmd_detect "${@:2}"
            ;;
        verify)
            cmd_verify "${@:2}"
            ;;
        doctor)
            cmd_doctor "${@:2}"
            ;;
        sync)
            cmd_sync "${@:2}"
            ;;
        test)
            cmd_test "${@:2}"
            ;;
        cleanup)
            cmd_cleanup "${@:2}"
            ;;
        cleanup-all)
            cleanup_all "${@:2}"
            ;;
        plugin)
            cmd_plugin "${@:2}"
            ;;
        run)
            cmd_run "${@:2}"
            ;;
        audit)
            cmd_audit "${@:2}"
            ;;
        config)
            cmd_config "${@:2}"
            ;;
        hooks)
            cmd_hooks "${@:2}"
            ;;
        watch)
            watch_mode "${@:2}"
            ;;
        task)
            cmd_task "${@:2}"
            ;;
        security)
            cmd_security "${@:2}"
            ;;
        version|-v|--version)
            cmd_version
            ;;
        *)
            # Smart error message with suggestions
            uaft_warn "Unknown command: $command"
            echo ""
            echo "Available commands:"
            echo "  cleanup, cleanup-all, test, plugin, run, audit, config, hooks, watch, task, security, init, detect, verify, doctor, sync, version"
            echo ""
            if type suggest_similar_command &>/dev/null; then
                suggest_similar_command "$command" || true
            fi
            uaft_error "Run 'uaft --help' for usage" 2
            ;;
    esac
}

# ============================================================================
# Command Implementations
# ============================================================================
# Each cmd_* function handles a specific CLI command.
# Pattern: Check for --help first, then process arguments.
# All commands follow consistent output patterns using uaft_* helpers.

# ----------------------------------------------------------------------------
# cmd_init - Initialize UAFT configuration for a project
# ----------------------------------------------------------------------------
# Creates .uaft/ directory and configuration files.
# Detects project type and sets up appropriate defaults.
#
# Usage: uaft init [--force]
# Options:
#   --force    Reinitialize even if already configured
#
# Returns: 0 on success, 1 on error

cmd_init() {
    case "${1:-}" in -h|--help|help) show_init_help; exit 0;; esac
    uaft_print_header "UAFT Initialize"
    uaft_info "Initializing UAFT for this project..."
    uaft_info "This feature will be implemented in Phase 1"
    exit 0
}

# ----------------------------------------------------------------------------
# cmd_detect - Auto-detect project type and configuration
# ----------------------------------------------------------------------------
# Scans project for known file patterns (package.json, pyproject.toml, etc.)
# and determines project type for automatic configuration.
#
# Usage: uaft detect [--json]
# Options:
#   --json    Output detection result as JSON
#
# Detects: Python, Node.js, Rust, Go, Full-stack, and more
# Returns: 0 on success, prints detected type

cmd_detect() {
    set +u
    local arg1="${1:-}"
    case "$arg1" in -h|--help|help) show_detect_help; exit 0;; esac
    uaft_print_header "UAFT Detect"
    uaft_info "Detecting project type..."
    # Source detector if not already loaded (for direct script use)
    if ! declare -F uaft_detect_project >/dev/null; then
        source "${UAFT_ROOT}/src/detector.sh"
    fi
    uaft_detect_project
    # Output as JSON if requested
    if [[ "$arg1" == "--json" ]]; then
        # Dump as JSON
        echo '{'
        first=1
        for key in "${!UAFT_DETECTION[@]}"; do
            [[ $first -eq 0 ]] && echo ","
            printf '  "%s": "%s"' "$key" "${UAFT_DETECTION[$key]}"
            first=0
        done | sort
        echo "\n}"
    else
        uaft_detect_dump
    fi
    exit 0
}

