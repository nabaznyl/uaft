# ----------------------------------------------------------------------------
# cmd_run - Run a plugin command
# ----------------------------------------------------------------------------
# Executes a plugin's main.sh with the given arguments.
# Plugins must be installed via 'uaft plugin install'.
#
# Usage: uaft run <plugin-name> [command] [args...]
#
# Examples:
#   uaft run git-flow status
#   uaft run cache-manager scan
#   uaft run dep-audit licenses
#
# Returns: Plugin's exit code

cmd_run() {
    local plugin_name="${1:-}"
    
    if [[ -z "$plugin_name" ]]; then
        echo "Usage: uaft run <plugin-name> [command] [args...]"
        echo ""
        echo "Installed plugins:"
        for plugin_dir in "$UAFT_PLUGIN_DIR"/*; do
            [[ -d "$plugin_dir" ]] && echo "  - $(basename "$plugin_dir")"
        done
        return 1
    fi
    
    local plugin_dir="$UAFT_PLUGIN_DIR/$plugin_name"
    
    if [[ ! -d "$plugin_dir" ]]; then
        uaft_error "Plugin not found: $plugin_name" 2
    fi
    
    if [[ ! -f "$plugin_dir/main.sh" ]]; then
        uaft_error "Plugin missing main.sh: $plugin_name" 2
    fi
    
    # Make sure main.sh is executable
    if [[ ! -x "$plugin_dir/main.sh" ]]; then
        chmod +x "$plugin_dir/main.sh" 2>/dev/null || true
    fi
    
    # Shift off plugin name, pass remaining args to plugin
    shift
    
    # Export useful variables for plugin
    export UAFT_ROOT
    export UAFT_PLUGIN_DIR
    export UAFT_PLUGIN_NAME="$plugin_name"
    export UAFT_PLUGIN_PATH="$plugin_dir"
    
    # Run plugin with remaining arguments
    bash "$plugin_dir/main.sh" "$@"
}

# ----------------------------------------------------------------------------
# cmd_audit - View and manage audit logs
# ----------------------------------------------------------------------------
# UAFT maintains an audit log of all operations for debugging,
# compliance, and historical tracking.
#
# Usage: uaft audit [action] [options]
# Actions:
#   show [filter]  - Display log entries (default: all)
#   --grep PATTERN - Search logs for pattern
#   --stats        - Show statistics summary
#   --clear [days] - Clear logs older than N days
#
# Log Location: ~/.uaft/audit.log
# Returns: 0 on success

cmd_audit() {
    local action="${1:-show}"
    
    case "$action" in
        -s|--show)
            audit_show "${2:-all}"
            ;;
        -g|--grep)
            audit_grep "${2:?Pattern required}"
            ;;
        --stats)
            audit_stats
            ;;
        --clear)
            audit_clear "${2:-}"
            ;;
        -h|--help)
            show_audit_help
            ;;
        *)
            audit_show "all"
            ;;
    esac
}

