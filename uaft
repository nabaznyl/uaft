# ----------------------------------------------------------------------------
# cmd_version - Display UAFT version information
# ----------------------------------------------------------------------------
# Reads version from VERSION file and outputs in standard format.
# Useful for scripting and version checks.
#
# Usage: uaft version
# Aliases: uaft -v, uaft --version
#
# Returns: 0 always, prints version string

cmd_version() {
    local version
    if [[ -f "${UAFT_ROOT}/VERSION" ]]; then
        version="$(cat "${UAFT_ROOT}/VERSION")"
    else
        version="0.0.1-dev"
    fi
    echo "uaft version ${version}"
}

# ----------------------------------------------------------------------------
# cmd_test - Run test suite using integrated test runner
# ----------------------------------------------------------------------------
# Executes project tests using the native UAFT test runner.
# Supports multiple output formats and parallel execution.
#
# Usage: uaft test [tests/] [--parallel] [--json output.json]
# Arguments:
#   [path]        Test file or directory (default: tests/)
# Options:
#   --parallel    Run tests in parallel
#   --json FILE   Output results as JSON
#   --verbose     Show detailed test output
#
# Delegates to: src/test_runner.sh (runner_main)
# Returns: 0 if all tests pass, 1 if any fail

cmd_test() {
    # Delegate to test runner
    if type runner_main &>/dev/null; then
        runner_main "$@"
        return $?
    else
        uaft_error "Test runner module not available" 1
    fi
}

# ----------------------------------------------------------------------------
# cmd_cleanup - Execute cleanup operations
# ----------------------------------------------------------------------------
# Manages project cleanup through profiles (standard, minimal, aggressive)
# or quick modes (quick, full, auto). Removes caches, build artifacts,
# temp files, and other development detritus.
#
# Usage: uaft cleanup [profile] [action] [options]
# Profiles:
#   standard    - Default cleanup (caches, temp files)
#   minimal     - Only obvious temp files
#   aggressive  - Deep clean including node_modules, .venv
#   quick       - Fast cache-only cleanup
#   full        - Comprehensive cleanup with security scan
#   auto        - Auto-detect and recommend cleanup
#
# Actions:
#   analyze     - Scan and report (default)
#   execute     - Actually perform cleanup
#   list        - List cleanup targets
#
# Options:
#   --dry-run   Show what would be cleaned without doing it
#
# Delegates to: src/cleanup.sh, src/plugin_cleanup_system.sh
# Returns: 0 on success

cmd_cleanup() {
    # Handle help first - before any parsing
    case "${1:-}" in
        -h|--help|help)
            show_cleanup_help
            exit 0
            ;;
    esac
    
    local profile="${1:-standard}"
    local action="${2:-analyze}"
    local dry_run=0
    
    # Plugin cleanup integration: quick, full, auto
    # These use the newer plugin_cleanup_system for enhanced functionality
    if [[ "$profile" == "quick" || "$profile" == "full" || "$profile" == "auto" ]]; then
        source "${UAFT_ROOT}/src/plugin_cleanup_system.sh"
        plugin_cleanup "$profile" "${@:2}"
        return $?
    fi

    # Load cleanup module for standard/minimal/aggressive profiles
    source "${UAFT_ROOT}/src/cleanup.sh"

    # Validate profile early
    if ! validate_cleanup_profile "$profile" 2>/dev/null; then
        uaft_error "Invalid cleanup profile: $profile" 2
    fi

    # Parse options - iterate through all arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--profile=*)
                if [[ "$1" == "-p" ]]; then
                    profile="$2"
                    shift 2
                else
                    profile="${1#*=}"
                    shift
                fi
                ;;
            -a|--analyze)
                action="analyze"
                shift
                ;;
            -e|--execute)
                action="execute"
                shift
                ;;
            -l|--list)
                action="list"
                shift
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            -h|--help)
                show_cleanup_help
                exit 0
                ;;
            *)
                uaft_warn "Unknown cleanup option: $1"
                shift
                ;;
        esac
    done

    # Audit the operation start (for logging/tracking)
    if type audit_log &>/dev/null; then
        audit_log "cleanup.start" "success" "profile=$profile action=$action"
    fi

    # Execute requested action
    case "$action" in
        analyze)
            uaft_cleanup_analyze "."
            ;;
        execute)
            uaft_cleanup_execute "." "$profile" "$dry_run"
            ;;
        list)
            uaft_cleanup_list_targets "."
            ;;
        *)
            uaft_error "Unknown cleanup action: $action" 1
            ;;
    esac
}

# ----------------------------------------------------------------------------
# cmd_plugin - Plugin management command
# ----------------------------------------------------------------------------
# Manages UAFT plugins: install, remove, list, enable, disable.
# Plugins extend UAFT functionality without modifying core.
#
# Usage: uaft plugin <action> [plugin-name]
# Actions:
#   list      - Show installed plugins (default)
#   install   - Install a plugin from registry
#   remove    - Uninstall a plugin
#   enable    - Enable a disabled plugin
#   disable   - Disable a plugin without removing
#   info      - Show details about a plugin
#
# Delegates to: src/plugin_manager.sh
# Returns: 0 on success, 1 on error

cmd_plugin() {
    local action="${1:-list}"
    
    case "$action" in
        -l|--list|list)
            cmd_plugin_list "${@:2}"
            ;;
        -I|--install|install)
            cmd_plugin_install "${@:2}"
            ;;
        -r|--remove|remove)
            cmd_plugin_remove "${@:2}"
            ;;
        -i|--info|info)
            cmd_plugin_info "${@:2}"
            ;;
        -s|--search|search)
            cmd_plugin_search "${@:2}"
            ;;
        -n|--new|new|create)
            cmd_plugin_new "${@:2}"
            ;;
        -h|--help|help)
            show_plugin_help
            exit 0
            ;;
        *)
            uaft_warn "Unknown plugin action: $action"
            show_plugin_help
            exit 2
            ;;
    esac
}

# Plugin command implementations
cmd_plugin_list() {
    local filter="installed"
    local format="table"

    # Parse additional arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --available) filter="available" ;;
            --all) filter="all" ;;
            --format) format="$2"; shift ;;
            *) ;;
        esac
        shift
    done

    uaft_print_header "Available Plugins"
    plugin_list --${filter} --format "$format"
}

cmd_plugin_install() {
    local source="${1:-}"
    
    [[ -z "$source" ]] && {
        uaft_error "Plugin source required (path, URL, or registry name)" 2
    }

    if ! validate_plugin_for_install "$source" 2>/dev/null; then
        uaft_warn "Invalid plugin source: $source"
        audit_log "error" "plugin_install" "Invalid source: $source"
        exit 2
    fi
    
    uaft_print_header "Installing Plugin"
    uaft_info "Source: $source"
    
    # Shift to get remaining args (--name, --force, etc)
    shift
    
    if plugin_install "$source" "$@"; then
        uaft_print_success "Plugin installed successfully"
        audit_log "info" "plugin_install" "Plugin installed: $source"
    else
        uaft_error "Failed to install plugin: $source" 2
    fi
}

cmd_plugin_remove() {
    local plugin_name="${1:-}"
    
    [[ -z "$plugin_name" ]] && {
        uaft_error "Plugin name required" 2
    }

    if ! validate_plugin_name "$plugin_name" 2>/dev/null; then
        uaft_warn "Invalid plugin name: $plugin_name"
        exit 2
    fi
    
    uaft_print_header "Removing Plugin"
    uaft_info "Plugin: $plugin_name"
    uaft_warn "This action will be removed and cannot be undone"
    
    read -p "Are you sure? [y/N]: " confirm
    if [[ "$confirm" != "y" ]] && [[ "$confirm" != "Y" ]]; then
        uaft_info "Removal cancelled"
        return 0
    fi
    
    # Shift to get remaining args (--keep-config, etc)
    shift
    
    if plugin_remove "$plugin_name" "$@"; then
        uaft_print_success "Plugin removed successfully"
        audit_log "info" "plugin_remove" "Plugin removed: $plugin_name"
    else
        uaft_error "Failed to remove plugin: $plugin_name" 2
    fi
}

# ----------------------------------------------------------------------------
# cmd_plugin_info - Display plugin information
# ----------------------------------------------------------------------------
# Shows detailed information about an installed or available plugin.
#
# Usage: uaft plugin info <plugin-name> [--format text|json]
# Returns: 0 on success, 2 if plugin not found

cmd_plugin_info() {
    local plugin_name="${1:-}"
    local format="${2:-text}"
    
    [[ -z "$plugin_name" ]] && {
        uaft_error "Plugin name required" 2
    }

    uaft_print_header "Plugin Information: $plugin_name"
    
    if plugin_info "$plugin_name" --format "$format"; then
        audit_log "info" "plugin_info" "Displayed info for: $plugin_name"
    else
        uaft_error "Plugin not found: $plugin_name" 2
    fi
}

# ----------------------------------------------------------------------------
# cmd_plugin_search - Search plugin registry
# ----------------------------------------------------------------------------
# Searches the plugin registry for matching plugins.
#
# Usage: uaft plugin search <keyword> [--limit N]
# Returns: 0 on success, 2 if keyword missing

cmd_plugin_search() {
    local keyword="${1:-}"
    
    [[ -z "$keyword" ]] && {
        uaft_error "Search keyword required" 2
    }

    uaft_print_header "Searching for: $keyword"
    
    local limit="${2:-10}"
    plugin_search "$keyword" --limit "$limit"
    audit_log "info" "plugin_search" "Searched for: $keyword"
}

# ----------------------------------------------------------------------------
# cmd_plugin_new - Scaffold a new plugin from template
# ----------------------------------------------------------------------------
# Creates a new plugin directory with all necessary files based on
# the built-in plugin template. Customizes plugin.yaml and main.sh
# with the provided plugin name and metadata.
#
# Usage: uaft plugin new <name> [options]
# Options:
#   --dir PATH      - Target directory (default: ~/.uaft/plugins/)
#   --description   - Plugin description
#   --author        - Author name
#   --version       - Initial version (default: 0.1.0)
#   --hooks         - Comma-separated hooks to enable (default: all)
#
# Template Location: $UAFT_DIR/templates/plugin-template/
# Returns: 0 on success, 1 on failure

cmd_plugin_new() {
    local name=""
    local target_dir="${UAFT_PLUGIN_DIR:-.uaft/plugins}"
    local description="A custom UAFT plugin"
    local author="${USER:-developer}"
    local version="0.1.0"
    local hooks="on_init,on_run,on_cleanup,on_detect"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dir)
                target_dir="$2"
                shift 2
                ;;
            --description)
                description="$2"
                shift 2
                ;;
            --author)
                author="$2"
                shift 2
                ;;
            --version)
                version="$2"
                shift 2
                ;;
            --hooks)
                hooks="$2"
                shift 2
                ;;
            -h|--help)
                cat << 'HELP'
Usage: uaft plugin new <name> [options]

Create a new plugin from the built-in template.

Options:
  --dir PATH        Target directory (default: .uaft/plugins/)
  --description STR Plugin description
  --author STR      Author name (default: $USER)
  --version STR     Initial version (default: 0.1.0)
  --hooks LIST      Comma-separated hooks: on_init,on_run,on_cleanup,on_detect

Examples:
  uaft plugin new my-linter
  uaft plugin new build-tool --description "Custom build automation"
  uaft plugin new formatter --hooks "on_run,on_cleanup" --version "1.0.0"
HELP
                return 0
                ;;
            -*)
                uaft_error "Unknown option: $1" 1
                ;;
            *)
                [[ -z "$name" ]] && name="$1" || uaft_error "Multiple names provided" 1
                shift
                ;;
        esac
    done
    
    # Validate plugin name
    [[ -z "$name" ]] && {
        uaft_error "Plugin name required. Usage: uaft plugin new <name>" 1
    }
    
    # Sanitize name (lowercase, hyphens only)
    local safe_name
    safe_name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' _' '-' | tr -cd 'a-z0-9-')
    
    [[ "$safe_name" != "$name" ]] && {
        uaft_warn "Sanitized name: '$name' → '$safe_name'"
    }
    
    # Check template exists
    local template_dir="${UAFT_ROOT}/templates/plugin-template"
    [[ ! -d "$template_dir" ]] && {
        uaft_error "Plugin template not found at: $template_dir" 1
    }
    
    # Create plugin directory
    local plugin_dir="${target_dir}/${safe_name}"
    
    [[ -d "$plugin_dir" ]] && {
        uaft_error "Plugin directory already exists: $plugin_dir" 1
    }
    
    uaft_print_header "Creating plugin: $safe_name"
    echo "  Target: $plugin_dir"
    
    # Create directory structure
    mkdir -p "$plugin_dir/hooks" || {
        uaft_error "Failed to create plugin directory" 1
    }
    
    # Copy and customize plugin.yaml
    local yaml_content
    yaml_content=$(cat << YAML
# Plugin metadata for: ${safe_name}
# Generated by: uaft plugin new
# Date: $(date '+%Y-%m-%d')

name: "${safe_name}"
version: "${version}"
description: "${description}"
author: "${author}"
license: "MIT"

# Minimum UAFT version required
min_uaft_version: "0.0.2"

# Hook points this plugin implements
hooks:
$(echo "$hooks" | tr ',' '\n' | while read -r hook; do
    [[ -n "$hook" ]] && echo "  - ${hook}"
done)

# Plugin configuration schema (optional)
config:
  enabled:
    type: boolean
    default: true
    description: "Enable or disable this plugin"
  
  # Add custom config options here
  # example_option:
  #   type: string
  #   default: "value"
  #   description: "Example configuration option"

# Command aliases (optional)
# commands:
#   alias: "full-command-name"

# Tags for discovery
tags:
  - custom
  - user-plugin
YAML
)
    echo "$yaml_content" > "$plugin_dir/plugin.yaml"
    uaft_print_success "Created plugin.yaml"
    
    # Create main.sh
    local main_content
    main_content=$(cat << 'MAIN'
#!/usr/bin/env bash
# ----------------------------------------------------------------------------
# PLUGIN_NAME - PLUGIN_DESCRIPTION
# ----------------------------------------------------------------------------
# Version: PLUGIN_VERSION
# Author: PLUGIN_AUTHOR
#
# This is the main entry point for the plugin.
# It sources hook files and provides the plugin interface.
# ----------------------------------------------------------------------------

set -euo pipefail

# Plugin directory (where this script lives)
PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source hook files
for hook_file in "$PLUGIN_DIR/hooks"/*.sh; do
    [[ -f "$hook_file" ]] && source "$hook_file"
done

# ----------------------------------------------------------------------------
# Plugin Main Function
# ----------------------------------------------------------------------------
# Called when the plugin is invoked directly.
# Override this to add custom behavior.

plugin_main() {
    local action="${1:-help}"
    
    case "$action" in
        help|--help|-h)
            echo "PLUGIN_NAME - PLUGIN_DESCRIPTION"
            echo ""
            echo "Usage: uaft run PLUGIN_NAME [action]"
            echo ""
            echo "Actions:"
            echo "  help     Show this help message"
            echo "  version  Show plugin version"
            echo "  info     Show plugin information"
            echo ""
            ;;
        version|--version|-v)
            echo "PLUGIN_NAME version PLUGIN_VERSION"
            ;;
        info)
            echo "Name: PLUGIN_NAME"
            echo "Version: PLUGIN_VERSION"
            echo "Author: PLUGIN_AUTHOR"
            echo "Description: PLUGIN_DESCRIPTION"
            ;;
        *)
            echo "Unknown action: $action"
            echo "Run 'uaft run PLUGIN_NAME help' for usage."
            return 1
            ;;
    esac
}

# Run main if executed directly
[[ "${BASH_SOURCE[0]}" == "$0" ]] && plugin_main "$@"
MAIN
)
    # Replace placeholders
    main_content="${main_content//PLUGIN_NAME/$safe_name}"
    main_content="${main_content//PLUGIN_DESCRIPTION/$description}"
    main_content="${main_content//PLUGIN_VERSION/$version}"
    main_content="${main_content//PLUGIN_AUTHOR/$author}"
    
    echo "$main_content" > "$plugin_dir/main.sh"
    chmod +x "$plugin_dir/main.sh"
    uaft_print_success "Created main.sh"
    
