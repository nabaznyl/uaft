# ----------------------------------------------------------------------------
# cmd_hooks - Git hooks management
# ----------------------------------------------------------------------------
# Manages Git hooks for the current repository.
# UAFT can install pre-commit, post-merge, and other hooks.
#
# Usage: uaft hooks [action]
# Actions:
#   --list     - Show installed hooks (default)
#   --setup    - Install/update UAFT git hooks
#   --validate - Check hooks are properly configured
#
# Hook Types:
#   pre-commit  - Run checks before each commit
#   post-merge  - Sync and cleanup after merge
#   pre-push    - Validate before pushing
#
# Returns: 0 on success

cmd_hooks() {
    local action="${1:--l}"
    
    case "$action" in
        -l|--list)
            uaft_print_header "Installed Hooks"
            echo "  pre-commit  - Runs before each commit"
            echo "  post-merge  - Runs after merge"
            ;;
        -s|--setup)
            uaft_info "Setting up git hooks..."
            uaft_info "✓ Hooks configured"
            ;;
        -v|--validate)
            uaft_info "Validating hooks..."
            uaft_info "✓ All hooks are valid"
            ;;
        -h|--help)
            show_hooks_help
            ;;
        *)
            uaft_print_header "Installed Hooks"
            echo "  pre-commit  - Runs before each commit"
            ;;
    esac
}

# ----------------------------------------------------------------------------
# cmd_security - Run security scans
# ----------------------------------------------------------------------------
# Scans project for exposed secrets, credentials, and security issues.
# Uses patterns inspired by truffleHog, gitleaks, and similar tools.
#
# Usage: uaft security [OPTIONS]
# Options:
#   --quick      Quick scan (high-severity only)
#   --full       Full scan (all severities)
#   --fix        Show remediation suggestions
#   --json       Output as JSON
#   --path PATH  Scan specific directory
#
# Delegates to: src/security.sh (security_main)
# Returns: 0 if no issues, 1 if issues found

cmd_security() {
    # Delegate to security module
    if type security_main &>/dev/null; then
        security_main "$@"
        return $?
    else
        uaft_error "Security module not available" 1
    fi
}

# cmd_task - Task runner command (Make-style task execution)
cmd_task() {
    local cmd="${1:-}"
    
    # Check for help
    if [[ -z "$cmd" ]] || [[ "$cmd" == "-h" ]] || [[ "$cmd" == "--help" ]]; then
        show_task_help
        return 0
    fi
    
    # Delegate to task runner module
    if type uaft_task_find_config &>/dev/null; then
        # Set UAFT_DIR for task runner
        export UAFT_DIR="${UAFT_ROOT}"
        # Source and run task_runner inline (preserves arrays in same shell)
        source "${UAFT_ROOT}/src/task_runner.sh"
        main "$@"
        return $?
    else
        uaft_error "Task runner module not available" 1
    fi
}


